upstreen django {
    server unix://var/www/Login_register_system/Login_register_system.sock;
}

server {
    listen      80;
    server_name 54.207.54.190;
    charset     utf-8;
    
    client_max_body_size    75M;
    
    location /media {
        alias /var/www/Login_register/media;
    }
    
    location /static {
        alias /var/www/Login_register/static;
    }
    
    location / {
        uwsgi_pass   django;
        include      /var/www/Login_register/uwsgi_params;
    }
}
